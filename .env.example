SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: use SQLite by default. Set POSTGRES_DB to switch to PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional APIs
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2

# Optional translation. Leave TRANSLATION_PROVIDER=none for no translation.
# Option 1: LibreTranslate, including a local Docker/self-hosted LibreTranslate server.
TRANSLATION_PROVIDER=none
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# Option 2: Any OpenAI-compatible endpoint: Ollama/LM Studio/vLLM/institutional endpoint.
# Example Ollama-compatible base URL if enabled: http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
