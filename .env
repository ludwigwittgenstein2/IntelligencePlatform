SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ------------------------------------------------------------
# Database
# Leave these blank to use SQLite.
# Fill these only if you later switch to PostgreSQL.
# ------------------------------------------------------------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------
# YouTube API
# Needed for crawling Tamil news YouTube channels.
# Replace this with your real YouTube Data API key.
# ------------------------------------------------------------
YOUTUBE_API_KEY=

# ------------------------------------------------------------
# X / Twitter API
# Optional for now.
# Needed only when we add Tamil Nadu X/Twitter tracking.
# ------------------------------------------------------------
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2

# ------------------------------------------------------------
# Translation Provider
# We are using Ollama through its OpenAI-compatible endpoint.
# ------------------------------------------------------------
TRANSLATION_PROVIDER=openai_compatible

# ------------------------------------------------------------
# LibreTranslate
# Not used now, but keep these here for later fallback.
# ------------------------------------------------------------
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=

# ------------------------------------------------------------
# Ollama OpenAI-compatible endpoint
# Make sure Ollama is running locally.
# ------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=gpt-oss:20b